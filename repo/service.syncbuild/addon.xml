<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.syncbuild" name="SyncBuild" version="1.0.4" provider-name="SyncBuild">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.dropbox" version="10.3.1"/>
    <import addon="script.module.qrcode" version="6.1.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>MIT</license>
    <summary lang="en_GB">Sync the shared Kodi build through Dropbox</summary>
    <description lang="en_GB">Keeps a few snapshots of this device's shared build in Dropbox and can reset this device to a newer snapshot from another device.</description>
  </extension>
</addon>
